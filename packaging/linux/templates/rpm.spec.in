# Packages the prebuilt Musicerer application binary and desktop integration.
%global debug_package %{nil}
%global __os_install_post %{nil}
AutoReqProv: no

Name:       musicerer
Version:    @VERSION@
Release:    1
Summary:    @SUMMARY@
License:    GPL-3.0-only
BuildArch:  @RPM_ARCH@
Recommends: xdg-desktop-portal

%description
Musicerer downloads audio from supported platforms and saves AAC .m4a files
with metadata and square cover art. Required media tools are downloaded and
maintained by Musicerer after installation, or can be provided through PATH.

%install
mkdir -p %{buildroot}
cp -a @STAGE@/. %{buildroot}/

%files
/usr/bin/musicerer
/usr/lib/musicerer
/usr/share/applications/musicerer.desktop
/usr/share/icons/hicolor/scalable/apps/musicerer.svg
%license /usr/share/doc/musicerer/LICENSE
