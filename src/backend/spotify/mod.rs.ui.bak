//! Spotify metadata resolver for Musicerer (no official Web API).
//!
//! Design
//! ------
//! * Free-account friendly: uses Spotify public oEmbed + embed page JSON.
//!   No Client ID / Client Secret required.
//! * Spotify title / artist / cover are authoritative for the UI and the
//!   final .m4a tags. YouTube / SoundCloud supply audio only, and fill
//!   tag fields only when Spotify did not provide them.
//! * Matching lives in matcher.rs (ytsearch / scsearch via yt-dlp).

mod models;
pub mod auth;
pub mod api;
mod fetch;
mod matcher;

pub use models::SpotifyMeta;

use crate::backend::{audio, emit, log, Inbox, LogLevel, Thumb, WorkerEvent};
use std::sync::atomic::{AtomicUsize, Ordering};
use std::sync::{Arc, Mutex};
use std::thread;
use url::Url;

pub fn is_spotify_url(raw: &str) -> bool {
    let Ok(u) = Url::parse(raw) else { return false; };
    let Some(host) = u.host_str() else { return false; };
    let host = host.to_ascii_lowercase();
    if host != "open.spotify.com"
        && host != "spotify.com"
        && !host.ends_with(".spotify.com")
    {
        return false;
    }
    let segs: Vec<&str> = u
        .path_segments()
        .map(|s| s.filter(|p| !p.is_empty()).collect())
        .unwrap_or_default();
    matches!(
        segs.first().copied(),
        Some("track") | Some("playlist") | Some("album")
    )
}

pub fn is_spotify_playlist_url(raw: &str) -> bool {
    let Ok(u) = Url::parse(raw) else { return false; };
    let segs: Vec<&str> = u
        .path_segments()
        .map(|s| s.filter(|p| !p.is_empty()).collect())
        .unwrap_or_default();
    matches!(segs.first().copied(), Some("playlist") | Some("album"))
}

pub fn spotify_id(raw: &str) -> Option<(String, String)> {
    let u = Url::parse(raw).ok()?;
    let segs: Vec<&str> = u
        .path_segments()
        .map(|s| s.filter(|p| !p.is_empty()).collect())
        .unwrap_or_default();
    if segs.len() < 2 {
        return None;
    }
    let kind = segs[0].to_string();
    let id = segs[1].split('?').next()?.to_string();
    if id.is_empty() {
        return None;
    }
    Some((kind, id))
}

pub fn spawn_resolve_track(id: u64, url: String, inbox: Inbox) {
    thread::spawn(move || {
        let result = (|| -> Result<(SpotifyMeta, Option<String>, Option<Thumb>), String> {
            let meta = fetch::fetch_track_meta(&url)?;
            let thumb = meta
                .cover_url
                .as_ref()
                .and_then(|u| fetch::fetch_bytes(u).ok())
                .and_then(|b| audio::make_rounded_thumb_from_bytes(&b, 40, 8.0).ok());
            let resolved = matcher::resolve_track(&meta).ok();
            if resolved.is_none() {
                log(
                    &inbox,
                    LogLevel::Warn,
                    format!("No audio match for Spotify track \"{}\"", meta.display_title()),
                );
            }
            Ok((meta, resolved, thumb))
        })();

        match result {
            Ok((meta, resolved_url, thumb)) => {
                let title = meta.display_title();
                let had = resolved_url.is_some();
                emit(
                    &inbox,
                    WorkerEvent::SpotifyResolved {
                        id,
                        meta,
                        resolved_url,
                        thumb,
                    },
                );
                if !had {
                    emit(
                        &inbox,
                        WorkerEvent::SpotifyFailed {
                            id,
                            title,
                            error: "no matching YouTube/SoundCloud audio found".into(),
                        },
                    );
                }
            }
            Err(error) => {
                emit(
                    &inbox,
                    WorkerEvent::SpotifyFailed {
                        id,
                        title: String::new(),
                        error,
                    },
                );
            }
        }
    });
}

pub fn spawn_resolve_playlist(id: u64, url: String, inbox: Inbox, _next_id_start: u64) {
    thread::spawn(move || {
        let tracks = match fetch::fetch_playlist_metas(&url) {
            Ok(t) if !t.is_empty() => t,
            Ok(_) => {
                emit(
                    &inbox,
                    WorkerEvent::SpotifyFailed {
                        id,
                        title: String::new(),
                        error: "playlist has no tracks (public embed returned empty)".into(),
                    },
                );
                return;
            }
            Err(error) => {
                emit(
                    &inbox,
                    WorkerEvent::SpotifyFailed {
                        id,
                        title: String::new(),
                        error,
                    },
                );
                return;
            }
        };

        let shared_cover = tracks
            .iter()
            .find_map(|t| t.cover_url.clone())
            .or_else(|| fetch::fetch_track_meta(&url).ok().and_then(|m| m.cover_url));

        let tracks: Vec<_> = tracks
            .into_iter()
            .map(|mut m| {
                if m.cover_url.is_none() {
                    m.cover_url = shared_cover.clone();
                }
                m
            })
            .collect();

        log(
            &inbox,
            LogLevel::Info,
            format!(
                "Spotify playlist: {} track(s) from public embed, matching audio...",
                tracks.len()
            ),
        );

        let n = tracks.len();
        let metas = Arc::new(tracks);
        let results = Arc::new(Mutex::new(vec![None; n]));
        let next = Arc::new(AtomicUsize::new(0));
        let workers = n.min(4).max(1);
        let mut handles = Vec::new();
        for _ in 0..workers {
            let metas = metas.clone();
            let results = results.clone();
            let next = next.clone();
            handles.push(thread::spawn(move || loop {
                let i = next.fetch_add(1, Ordering::Relaxed);
                if i >= metas.len() {
                    break;
                }
                let resolved = matcher::resolve_track(&metas[i]).ok();
                if let Ok(mut g) = results.lock() {
                    g[i] = Some((metas[i].clone(), resolved));
                }
            }));
        }
        for h in handles {
            let _ = h.join();
        }

        let paired = results
            .lock()
            .map(|g| g.clone())
            .unwrap_or_default()
            .into_iter()
            .flatten()
            .collect::<Vec<_>>();

        use crate::backend::playlist::PlaylistEntry;
        let mut entries = Vec::with_capacity(paired.len());
        for (meta, resolved) in &paired {
            if resolved.is_none() {
                log(
                    &inbox,
                    LogLevel::Warn,
                    format!(
                        "No audio match for \"{}\" - will be marked failed.",
                        meta.display_title()
                    ),
                );
            }
            let entry_url = resolved
                .clone()
                .unwrap_or_else(|| format!("spotify:unresolved:{}", meta.title));
            entries.push(PlaylistEntry {
                url: entry_url,
                title: meta.display_title(),
                thumb_url: meta.cover_url.clone(),
                spotify: Some(meta.clone()),
            });
        }

        emit(
            &inbox,
            WorkerEvent::PlaylistResolved {
                id,
                title: "Spotify playlist".into(),
                entries,
                main: 0,
            },
        );

    });
}
