use super::helpers::READING_PLAYLIST;
use super::{guess_name_from_url, App, Message};
use crate::backend::{
    detect_source, is_playlist_url, normalize_url, spawn_preview, spawn_resolve, spawn_worker,
    Source,
};
use crate::ui::{ItemStatus, QueueItem, UiLogLevel, View};

use iced::Task;
use std::path::PathBuf;
use std::sync::atomic::Ordering;

impl App {
    pub fn update(&mut self, message: Message) -> Task<Message> {
        match message {
            Message::WindowDragged => {
                return iced::window::latest().and_then(|id| iced::window::drag(id));
            }
            Message::WindowMinimize => {
                return iced::window::latest().and_then(|id| iced::window::minimize(id, true));
            }
            Message::WindowMaximize => {
                return iced::window::latest().and_then(|id| iced::window::toggle_maximize(id));
            }
            Message::WindowClose => {
                return iced::window::latest().and_then(|id| iced::window::close(id));
            }
            Message::WindowResize(dir) => {
                return iced::window::latest().and_then(move |id| iced::window::drag_resize(id, dir));
            }
            Message::OpenOutputDir => {
                let path = std::path::Path::new(&self.output_dir);
                let _ = std::fs::create_dir_all(path);
                #[cfg(target_os = "windows")]
                let _ = std::process::Command::new("explorer").arg(path).spawn();
                #[cfg(target_os = "macos")]
                let _ = std::process::Command::new("open").arg(path).spawn();
                #[cfg(target_os = "linux")]
                let _ = std::process::Command::new("xdg-open").arg(path).spawn();
            }
            Message::TogglePlatformsDialog => self.show_platforms = !self.show_platforms,
            Message::SwitchView(v) => self.current_view = v,
            Message::ToggleLog => self.show_log = !self.show_log,
            Message::DismissVpnWarning => self.startup_vpn_warning = None,
            Message::UrlChanged(v) => self.url_input = v,
            Message::AddUrl => {
                if self.downloading { return Task::none(); }
                let url = normalize_url(&self.url_input);
                if url.is_empty() { return Task::none(); }
                let source = detect_source(&url);
                if source == Source::Unsupported {
                    self.push_log(
                        UiLogLevel::Warn,
                        "Only SoundCloud, YouTube and Spotify links are supported.",
                    );
                    self.show_log = true;
                    self.log_attention = 16;
                    return Task::none();
                }
                if source == Source::Spotify {
                    let id = self.next_id;
                    self.next_id += 1;
                    let is_pl = crate::backend::spotify::is_spotify_playlist_url(&url);
                    let display_name = if is_pl {
                        READING_PLAYLIST.to_string()
                    } else {
                        guess_name_from_url(&url, source)
                    };
                    let mut item = QueueItem::new(id, url.clone(), source, display_name);
                    item.resolving = true;
                    if is_pl {
                        let start = self.next_id;
                        self.next_id += 500;
                        crate::backend::spotify::spawn_resolve_playlist(
                            id,
                            url,
                            self.inbox.clone(),
                            start,
                        );
                    } else {
                        crate::backend::spotify::spawn_resolve_track(
                            id,
                            url,
                            self.inbox.clone(),
                        );
                    }
                    self.queue.push(item);
                    self.url_input.clear();
                    return Task::none();
                }
                let id = self.next_id;
                self.next_id += 1;
                let is_playlist = is_playlist_url(&url, source);
                let display_name = if is_playlist {
                    READING_PLAYLIST.to_string()
                } else {
                    guess_name_from_url(&url, source)
                };
                let mut item = QueueItem::new(id, url.clone(), source, display_name);
                if is_playlist {
                    item.resolving = true;
                    spawn_resolve(id, url, self.cookies_path(), self.inbox.clone());
                } else {
                    spawn_preview(id, url, self.cookies_path(), self.inbox.clone());
                }
                self.queue.push(item);
                self.url_input.clear();
            }
            Message::RemoveTrack(id) => {
                if !self.downloading {
                    // Removing a playlist's main row removes the whole playlist.
                    self.queue.retain(|i| i.id != id);
                    for item in &mut self.queue {
                        if let Some(group) = &mut item.group {
                            group.children.retain(|c| c.id != id);
                            if group.children.is_empty() { item.group = None; }
                        }
                    }
                }
            }
            Message::ToggleGroup(id) => {
                if let Some(group) = self
                    .queue
                    .iter_mut()
                    .find(|i| i.id == id)
                    .and_then(|i| i.group.as_mut())
                {
                    group.expanded = !group.expanded;
                }
            }
            Message::ClearQueue => {
                if !self.downloading { self.queue.clear(); }
            }
            Message::OutputDirChanged(v) => {
                self.output_dir = v;
                self.update_disk_space();
                self.save_config();
            }
            Message::BrowseOutputDir => {
                return Task::perform(
                    async { rfd::FileDialog::new().pick_folder() },
                    Message::OutputDirPicked,
                );
            }
            Message::OutputDirPicked(p) => {
                if let Some(p) = p {
                    self.output_dir = p.to_string_lossy().to_string();
                    self.update_disk_space();
                    self.save_config();
                }
            }
            Message::CookiesChanged(v) => {
                self.cookies_input = v;
                self.save_config();
            }
            Message::SpotifyClientIdChanged(v) => {
                self.spotify_client_id = v;
                self.save_config();
            }
            Message::SpotifyClientSecretChanged(v) => {
                self.spotify_client_secret = v;
                self.save_config();
            }
            Message::BrowseCookies => {
                return Task::perform(
                    async {
                        rfd::FileDialog::new()
                            .add_filter("Cookies", &["txt"])
                            .pick_file()
                    },
                    Message::CookiesPicked,
                );
            }
            Message::CookiesPicked(p) => {
                if let Some(p) = p {
                    self.cookies_input = p.to_string_lossy().to_string();
                    self.save_config();
                }
            }
            Message::StartQueue => {
                if self.downloading || self.queue.is_empty() { return Task::none(); }
                let output_dir = PathBuf::from(self.output_dir.trim());
                if output_dir.as_os_str().is_empty() {
                    self.push_log(UiLogLevel::Error, "Choose an output folder first.");
                    self.current_view = View::Settings;
                    return Task::none();
                }
                if let Err(e) = std::fs::create_dir_all(&output_dir) {
                    self.push_log(
                        UiLogLevel::Error,
                        format!("Cannot create output folder: {e}"),
                    );
                    return Task::none();
                }
                let cookies = if self.cookies_input.trim().is_empty() {
                    None
                } else {
                    let p = PathBuf::from(self.cookies_input.trim());
                    if !p.exists() {
                        self.push_log(
                            UiLogLevel::Error,
                            format!("Cookies file not found: {}", p.display()),
                        );
                        return Task::none();
                    }
                    Some(p)
                };
                if self.queue.iter().any(|i| i.resolving) {
                    self.push_log(UiLogLevel::Warn, "Wait for playlists to finish loading first.");
                    return Task::none();
                }
                let items = self
                    .tracks()
                    .map(|t| {
                        let download_url = t
                            .resolved_url
                            .clone()
                            .unwrap_or_else(|| t.url.clone());
                        (t.id, download_url, t.spotify.clone())
                    })
                    .collect::<Vec<_>>();
                for item in &mut self.queue {
                    item.for_each_track_mut(|t| {
                        t.status = ItemStatus::Pending;
                        t.progress = 0.0;
                    });
                }
                self.downloading = true;
                self.stop_flag.store(false, Ordering::SeqCst);
                self.logs.clear();
                self.push_log(UiLogLevel::Info, "Queue started.");
                self.status = "Starting\u{2026}".to_string();
                spawn_worker(
                    items,
                    output_dir,
                    cookies,
                    self.inbox.clone(),
                    self.stop_flag.clone(),
                );
            }
Message::StopQueue => {
                self.stop_flag.store(true, Ordering::SeqCst);
                for item in self.queue.iter_mut() {
                    if item.resolving {
                        item.resolving = false;
                        item.status = ItemStatus::Stopped;
                    }
                }
                if self.downloading {
                    self.status = "Stopping...".to_string();
                    self.push_log(
                        UiLogLevel::Warn,
                        "Stop requested - terminating active downloads.",
                    );
                }
            }
Message::PollWorker => {
                if self.log_attention > 0 {
                    self.log_attention = self.log_attention.saturating_sub(1);
                }
                let events = {
                    let mut g = self.inbox.lock().unwrap_or_else(|e| e.into_inner());
                    std::mem::take(&mut *g)
                };
                for e in events { self.handle_worker_event(e); }
            }
        }
        Task::none()
    }

    pub(super) fn push_log(&mut self, level: UiLogLevel, text: impl Into<String>) {
        self.logs.push_back(crate::ui::LogLine { level, text: text.into() });
        while self.logs.len() > 400 { self.logs.pop_front(); }
    }
}
